generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STANDARD_USER
  DOCUMENT_OWNER
  AUDITOR
  ADMINISTRATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ScanVerdict {
  CLEAN
  INFECTED
  SKIPPED
}

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  displayName    String
  passwordHash   String
  role           Role       @default(STANDARD_USER)
  status         UserStatus @default(ACTIVE)
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime   @default(now())
  lastLoginAt    DateTime?

  documents        Document[]           @relation("DocumentOwner")
  permissionsHeld  DocumentPermission[] @relation("Grantee")
  permissionsGiven DocumentPermission[] @relation("Grantor")
  shareLinks       ShareLink[]
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]

  @@index([email])
}

model Document {
  id             String    @id @default(uuid())
  legacyId       Int       @unique @default(autoincrement())
  title          String
  description    String    @default("")
  category       String    @default("General")
  originalName   String
  mimeType       String
  sizeBytes      Int
  storageKey     String    @unique
  sha256         String
  ownerId        String
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  scanVerdict    ScanVerdict @default(SKIPPED)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner       User                 @relation("DocumentOwner", fields: [ownerId], references: [id])
  permissions DocumentPermission[]
  shareLinks  ShareLink[]
  key         DocumentKey?

  @@index([ownerId])
  @@index([isDeleted])
}

model DocumentPermission {
  id           String    @id @default(uuid())
  documentId   String
  granteeId    String
  canView      Boolean   @default(true)
  canDownload  Boolean   @default(false)
  canReshare   Boolean   @default(false)
  grantedById  String
  grantedAt    DateTime  @default(now())
  expiresAt    DateTime?

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  grantee   User     @relation("Grantee", fields: [granteeId], references: [id])
  grantedBy User     @relation("Grantor", fields: [grantedById], references: [id])

  @@unique([documentId, granteeId])
  @@index([granteeId])
}

model ShareLink {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  documentId   String
  createdById  String
  canDownload  Boolean   @default(true)
  passwordHash String?
  expiresAt    DateTime?
  singleUse    Boolean   @default(false)
  useCount     Int       @default(0)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([documentId])
}

model DocumentKey {
  id         String   @id @default(uuid())
  documentId String   @unique
  wrappedDek String
  kekId      String   @default("kek-v1")
  iv         String
  authTag    String
  wrapIv     String
  wrapTag    String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  sequence   Int      @unique @default(autoincrement())
  eventType  String
  actorId    String?
  actorEmail String?
  targetType String?
  targetId   String?
  outcome    String
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  prevHash   String
  recordHash String
  createdAt  DateTime  @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([eventType])
  @@index([actorId])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
